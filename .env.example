CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# Keep the existing model; change only for an explicit comparison test.
CARTESIA_STT_MODEL=ink-whisper
# Optional: interpret conversational questions only; never grades or processes letters.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

VAD_CONFIDENCE=0.7
VAD_START_SECS=0.08
VAD_STOP_SECS=0.2
SMART_TURN_ENABLED=true
SMART_TURN_CPU_COUNT=1
SMART_TURN_AUDIO_SECS=8
SPELLING_MIN_SILENCE_SECS=1.0
SPELLING_COMPLETION_SECS=5.0
SPELLING_MAX_COMPLETION_SECS=5.0
# Extend the silence window to accommodate observed pauses between letters.
SPELLING_PAUSE_MARGIN_SECS=0.6
SPELLING_ADAPTIVE_MAX_SECS=4.0
STT_FINAL_WAIT_SECS=2.5
SPELLING_DEBUG=false
